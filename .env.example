# Copie para .env e ajuste. O docker compose le o .env automaticamente.
# Nunca versione o .env: ele guarda senhas.

# Banco de dados (PostgreSQL)
DB_NAME=contalitro
DB_USER=contalitro
DB_PASSWORD=contalitro
# Porta do Postgres exposta no host (para rodar o backend fora do Docker com o perfil prod)
DB_PORT=5432

# Porta do backend exposta no host
APP_PORT=8080

# Em prod o veiculo precisa ser cadastrado pela API (POST /veiculos) antes de enviar dados.
# true cadastra automaticamente qualquer equipamento que publicar no broker.
AUTO_CADASTRO=false

# Broker MQTT (HiveMQ Cloud). Sem MQTT_HOST o backend sobe so com a API.
# A credencial pode ser do tipo Subscribe Only: o backend nao publica nada.
MQTT_HOST=
MQTT_PORT=8883
MQTT_PROTOCOL=ssl
MQTT_USER=
MQTT_PASSWORD=
# Precisa ser unico no broker: duas instancias com o mesmo id derrubam uma a outra
MQTT_CLIENT_ID=contalitro-backend

# ThingsBoard: o token de cada veiculo e informado no cadastro do veiculo
TB_ENABLED=false
TB_URL=https://thingsboard.cloud
